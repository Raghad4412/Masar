<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="csrf-token" content="@(AntiforgeryToken)">
<title>@(ViewData["title"] ?? "Masar")</title>
<link rel="icon" href="@(Routes.Asset("img/masar-mark.png"))">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@400;500;600;700;800&family=Inter:wght@@400;500;600&display=swap" rel="stylesheet">
<link href="@(Routes.Asset("css/ms-app.css"))" rel="stylesheet">
<link href="@(Routes.Asset("css/ms-forms.css"))" rel="stylesheet">
<link href="@(Routes.Asset("css/ms-responsive.css"))" rel="stylesheet">
<link href="@(Routes.Asset("css/ms-polish.css"))" rel="stylesheet">
<script src="@(Routes.Asset("js/ms-ui.js"))" defer></script>
<script src="@(Routes.Asset("js/ms-polish.js"))" defer></script>
</head>
<body class="ms-app">

<header class="app-h">
  <div class="wrap">
    <button type="button" class="md-burger" data-md-toggle aria-label="Menu" aria-expanded="false"><i class="bi bi-list"></i></button>
    <a class="m-logo" href="@(Routes.To("experts.index"))"><img src="@(Routes.Asset("img/masar-mark.png"))" alt="Masar">
      <span><span class="w">MASAR</span><span class="t">Your Business Partner</span></span></a>
    <nav class="app-nav">
      <a href="@(Routes.To("experts.index"))" class="@Css.Classes(("on", Http.RouteIs("experts.*")))">Find an Expert</a>
      <a href="@(Routes.To("services.index"))" class="@Css.Classes(("on", Http.RouteIs("services.index")))">Services</a>
      <a href="@(Routes.To("consultation"))" class="@Css.Classes(("on", Http.RouteIs("consultation")))">Consultation</a>
      @if ((NavItem ?? "bookings") == "requests")
{
<text>
        <a href="@(Routes.To("requests.index"))" class="@Css.Classes(("on", (Http.RouteIs("requests.*") || Http.RouteIs("proposals.*")) || Http.RouteIs("services.show")))">My Requests</a>
        <a href="@(Routes.To("projects"))" class="@Css.Classes(("on", Http.RouteIs("projects")))">My Projects</a>
      </text>
}
else
{
<text>
        <a href="@(Routes.To("projects"))" class="@Css.Classes(("on", Http.RouteIs("projects")))">My Projects</a>
        <a href="@(Routes.To("bookings.index"))" class="@Css.Classes(("on", Http.RouteIs("bookings.*") || Http.RouteIs("invoices.*")))">My Bookings</a>
      </text>
}
      <a href="@(Routes.To("messages"))" class="@Css.Classes(("on", Http.RouteIs("messages")))">Messages</a>
    </nav>
    <div class="app-right">
      @if (AuthUser != null)
{
<text>
        
        <span class="bell" data-ms-pop="ms-notifications"><i class="bi bi-bell"></i>@if ((UnreadCount ?? 0) > 0)
{
<text><span class="dot">@(UnreadCount)</span></text>
}
          @await Html.PartialAsync("~/Views/Partials/_NotificationsMenu.cshtml")
        </span>
        <span class="me" data-ms-pop="ms-user-menu">
          @await Html.PartialAsync("~/Views/Components/_Avatar.cshtml", new AvatarModel { User = AuthUser, Box = "ava ava-sm", Fallback = "av av-sm" }) @(AuthUser.ShortName) <i class="bi bi-chevron-down"></i>
          @await Html.PartialAsync("~/Views/Partials/_ClientMenu.cshtml")
        </span>
      </text>
}
else
{
<text>
        
        <a class="m-link" href="@(Routes.To("login"))">Log in</a>
        <a class="m-btn m-btn-primary m-btn-sm" href="@(Routes.To("register"))">Create account</a>
      </text>
}
    </div>
  </div>
</header>
@if (IsSectionDefined("Crumb"))
{
<text>
  <div class="crumb"><div class="wrap">@RenderSection("Crumb", required: false)</div></div>
</text>
}

@RenderSection("Prepage", required: false)
<main class="page @(PageClass ?? "")">
  @RenderBody()
</main>

@await Html.PartialAsync("~/Views/Partials/_Toasts.cshtml")
@RenderSection("Dialogs", required: false)

</body>
</html>
