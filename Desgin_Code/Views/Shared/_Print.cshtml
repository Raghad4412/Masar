<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>@(ViewData["title"] ?? "Masar")</title>
<link rel="icon" href="@(Routes.Asset("img/masar-mark.png"))">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@400;500;600;700;800&family=Inter:wght@@400;500;600&display=swap" rel="stylesheet">
<link href="@(Routes.Asset("css/ms-app.css"))" rel="stylesheet">
<link href="@(Routes.Asset("css/ms-forms.css"))" rel="stylesheet">
<link href="@(Routes.Asset("css/ms-responsive.css"))" rel="stylesheet">
<link href="@(Routes.Asset("css/ms-polish.css"))" rel="stylesheet">
</head>
<body class="ms-app ms-print">

<div class="ms-print-bar">
  <div class="in">
    <a class="m-logo" href="@(Routes.Url("/"))"><img src="@(Routes.Asset("img/masar-mark.png"))" alt="Masar">
      <span><span class="w">MASAR</span><span class="t">Your Business Partner</span></span></a>
    <div class="sp">
      <span class="m-small">@(ViewData["doc-label"] ?? "Document")</span>
      <button type="button" class="m-btn m-btn-primary m-btn-sm" onclick="window.print()"><i class="bi bi-printer"></i> Print</button>
      <button type="button" class="m-btn m-btn-outline m-btn-sm" onclick="window.print()"><i class="bi bi-filetype-pdf"></i> Save as PDF</button>
      @if (ViewData["back"] != null)
{
<text>
        <a class="m-btn m-btn-outline m-btn-sm" href="@(ViewData["back"] ?? "")"><i class="bi bi-arrow-left"></i> Back</a>
      </text>
}
      <button type="button" class="m-btn m-btn-outline m-btn-sm ms-print-close" onclick="window.close()"><i class="bi bi-x-lg"></i> Close</button>
    </div>
  </div>
</div>

<main class="ms-print-page">
  @RenderBody()
</main>

<script>
  if (!window.opener) {
    document.querySelectorAll('.ms-print-close').forEach(function (b) { b.hidden = true; });
  }
</script>

</body>
</html>
