<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="csrf-token" content="@(AntiforgeryToken)">
<title>@(ViewData["title"] ?? "Masar")</title>
<link rel="icon" href="@(Routes.Asset("img/masar-mark.png"))">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@400;500;600;700;800&family=Inter:wght@@400;500;600&display=swap" rel="stylesheet">
<link href="@(Routes.Asset("css/ms-app.css"))" rel="stylesheet">
<link href="@(Routes.Asset("css/ms-forms.css"))" rel="stylesheet">
<link href="@(Routes.Asset("css/ms-responsive.css"))" rel="stylesheet">
<link href="@(Routes.Asset("css/ms-polish.css"))" rel="stylesheet">
<script src="@(Routes.Asset("js/ms-ui.js"))" defer></script>
<script src="@(Routes.Asset("js/ms-polish.js"))" defer></script>
</head>
<body class="ms-dash">

<script>try{if(localStorage.getItem('masar:rail')==='1')document.body.classList.add('rail-min');}catch(e){}</script>

<div class="dash">
  @if ((Panel ?? "expert") == "admin")
{
<text>
    @await Html.PartialAsync("~/Views/Partials/_AdminSidebar.cshtml")
  </text>
}
else
{
<text>
    @await Html.PartialAsync("~/Views/Partials/_ExpertSidebar.cshtml")
  </text>
}
  <div class="md-backdrop"></div>
  <div class="dmain">
    <header class="dtop">
      <button type="button" class="md-burger" data-md-toggle aria-label="Menu" aria-expanded="false"><i class="bi bi-list"></i></button>
      <div class="dtop-ttl">
        
        <span class="kick"><i class="bi bi-calendar3"></i> @(Clock.Now.Format("l j F Y"))</span>
        <div class="tt">@(ViewData["dtitle"] ?? "")</div>
      </div>
      <form class="dsearch" method="GET" action="@((Panel ?? "expert") == "admin" ? Routes.To("admin.users") : Routes.To("expert.requests"))">
        <i class="bi bi-search"></i>
        
        <input type="search" name="q" value="@(Http.Query("q"))" maxlength="80" placeholder="Search requests or clients"
               style="flex:1;min-width:0;border:0;outline:0;background:transparent;font:inherit;color:inherit;padding:0">
      </form>
      @RenderSection("DtopAction", required: false)
      
      <span class="bell" data-ms-pop="ms-notifications"><i class="bi bi-bell"></i>@if ((UnreadCount ?? 0) > 0)
{
<text><span class="dot">@(UnreadCount)</span></text>
}
        @await Html.PartialAsync("~/Views/Partials/_NotificationsMenu.cshtml")
      </span>
      <div class="dme" data-ms-pop="ms-user-menu">
        @await Html.PartialAsync("~/Views/Components/_Avatar.cshtml", new AvatarModel { User = AuthUser, Box = "ava ava-sm" })
        <div><b>@(AuthUser.FullName)</b><span>@(DmeCaption ?? "")</span></div><i class="bi bi-chevron-down"></i>
        @await Html.PartialAsync("~/Views/Partials/_DashMenu.cshtml")
      </div>
    </header>
    
    <main class="@(MainClass ?? "dpage")">
      
      @if (ViewData["dcrumb"] != null)
{
<text>
        <nav class="ms-crumb @((MainClass ?? "dpage") == "dpage" ? "" : "wrap")" aria-label="Breadcrumb">
          <a href="@((Panel ?? "expert") == "admin" ? Routes.To("admin.overview") : Routes.To("expert.dashboard"))">@((Panel ?? "expert") == "admin" ? "Admin panel" : "Expert workspace")</a>
          <i class="bi bi-chevron-right"></i><span class="cur">@(ViewData["dcrumb"] ?? "")</span>
        </nav>
      </text>
}
      @RenderBody()
    </main>
  </div>
</div>

@await Html.PartialAsync("~/Views/Partials/_Toasts.cshtml")
@RenderSection("Dialogs", required: false)

</body>
</html>
