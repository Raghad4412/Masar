@model object
@{
    Layout = "~/Views/Shared/_Auth.cshtml";
    ViewData["title"] = "Your password is updated - Masar";
}
@await Html.PartialAsync("~/Views/Partials/_AuthTop.cshtml")
<div class="m-center">
  <img class="m-center-img" src="@(Routes.Asset("img/auth-handshake.jpg"))" alt="">
  <div class="m-center-veil"></div>
  <div class="m-card m-card-pad" style="width:560px;text-align:center">
    <div class="m-icon-xl" style="margin:0 auto 28px;background:#E7F2EC;color:#1E7A4D"><i class="bi bi-check-circle"></i></div>
    <h1 class="m-h1">Your password is updated</h1>
    <p class="m-body" style="margin:14px 0 30px">You can now log in with your new password. For your safety we
      signed you out of every other device.</p>
    <a href="@(Routes.To("login"))" class="m-btn m-btn-primary m-btn-block">Go to log in</a>
    <p class="m-small" style="margin-top:24px">Did not request this change? <a href="mailto:@(Config.Masar.SupportEmail)" style="color:var(--teal);font-weight:600">Contact support</a></p>
  </div>
</div>
