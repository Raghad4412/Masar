@{
    var line = (string)ViewData["line"]!;
    var price = (decimal)ViewData["price"]!;
    var commission = (decimal)ViewData["commission"]!;
    var vat = (decimal)ViewData["vat"]!;
    var total = (decimal)ViewData["total"]!;
}
<div class="pl"><span>@(line)</span><span>@(Helpers.NumberFormat(price, 2))</span></div>
<div class="pl"><span>Platform commission (@(Helpers.ToInt32((Config.Masar.Commission * 100)))%)</span><span>@(Helpers.NumberFormat(commission, 2))</span></div>
<div class="pl"><span>VAT (@(Helpers.ToInt32((Config.Masar.Vat * 100)))%)</span><span>@(Helpers.NumberFormat(vat, 2))</span></div>
<div class="pt"><span>Total</span><span class="tot">@(Helpers.NumberFormat(total, 2)) SAR</span></div>
