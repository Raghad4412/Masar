@model Masar.ViewModels.ExpertArea.ProposalSentViewModel
@{
    Layout = "~/Views/Shared/_Dash.cshtml";
    ViewData["panel"] = "expert";
    ViewData["dmeCaption"] = Model.DmeCaption;
    ViewData["mainClass"] = "page center-page";
    ViewData["title"] = "You already sent a proposal - Masar";
    ViewData["dtitle"] = "Submit a Proposal";
    ViewData["dcrumb"] = "Submit a proposal";
}
<div class="statebox">
  <div class="bigicon warn"><i class="bi bi-exclamation-triangle"></i></div>
  <h1 class="m-h1" style="margin-top:24px">You already sent a proposal</h1>
  <p class="m-body" style="margin-top:12px;max-width:480px">Masar allows one proposal per request, so you
    cannot send a second one for <b>@(Model.Request.RequestReference)</b>. You can edit your proposal while the client has
    not decided.</p>
  <div class="card pad" style="width:580px;margin-top:26px;text-align:left">
    <div class="d-flex align-items-center justify-content-between">
      <div><div class="m-h4">@(Model.Request.Title)</div>
        <p class="m-small">@(Model.Request.Client?.User?.FullName), @(Model.Request.Client?.User?.City) &middot; valid until @(Model.Proposal.ExpirationTime.Format("j M Y"))</p></div>
      @await Html.PartialAsync("~/Views/Components/_Status.cshtml", new StatusModel { Kind = "proposal", Value = Model.Proposal.ProposalStatus })
    </div>
    <div class="conf-grid">
      <div><span class="m-small">Your price</span><b>@(Helpers.NumberFormat(Convert.ToDouble(Model.Proposal.ProposalPrice), 2)) SAR</b></div>
      <div><span class="m-small">Delivery</span><b>@(Model.Proposal.DeliveryTime) days</b></div>
      <div><span class="m-small">Client budget</span><b>@(Model.Request.BudgetDisplay)</b></div>
      <div><span class="m-small">Other proposals</span><b>@(Model.Others)</b></div>
    </div>
    @if (Model.Proposal.ProposalStatus == "Waiting")
{
<text>
      <div class="conf-cta">
        <a href="#" class="m-btn m-btn-outline" data-ms-open="ms-withdraw">Withdraw</a>
        <a href="@(Routes.To("expert.proposal.create", new { serviceRequest = Model.Request.ServiceRequestId, edit = 1 }))" class="m-btn m-btn-primary">Edit my proposal</a>
      </div>
    </text>
}
  </div>
  <a class="m-link" href="@(Routes.To("expert.requests"))" style="margin-top:22px"><i class="bi bi-arrow-left"></i> Back to open requests</a>
</div>

@section Dialogs {

@if (Model.Proposal.ProposalStatus == "Waiting")
{
<text>
  <div class="ms-dialog" id="ms-withdraw" hidden>
    <form class="card pad" style="width:520px" method="POST" action="@(Routes.To("expert.proposal.withdraw", new { proposal = Model.Proposal.ProposalId }))">
      @Html.AntiForgeryToken()
      <h3 class="m-h3">Withdraw this proposal?</h3>
      <p class="m-body" style="margin-top:10px">The client no longer sees it, and you cannot send a new one
        for this request.</p>
      <div class="m-fg" style="margin-top:18px">
        <label class="m-label" for="withdraw-reason">Reason <span class="opt">Optional</span></label>
        <div class="m-input area"><textarea id="withdraw-reason" name="reason" maxlength="300" placeholder="Why are you withdrawing?"></textarea></div>
      </div>
      <div class="d-flex gap-3" style="margin-top:20px;justify-content:flex-end">
        <button type="button" class="m-btn m-btn-outline" data-ms-close>Keep it</button>
        <button type="submit" class="m-btn m-btn-primary">Withdraw the proposal</button>
      </div>
    </form>
  </div>
</text>
}

}
