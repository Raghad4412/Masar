@model Masar.ViewModels.ExpertArea.ExpertProfileViewModel
@{
    Layout = "~/Views/Shared/_Dash.cshtml";
    ViewData["panel"] = "expert";
    ViewData["dmeCaption"] = Model.DmeCaption;
    ViewData["title"] = "Profile and Verification - Masar";
    ViewData["dtitle"] = "Profile and Verification";
    ViewData["dcrumb"] = "Profile and Verification";
}
<div class="d2">
<div class="dcard">
  <div class="dch"><div><h3 class="m-h3">My public profile</h3><p class="m-small">This is what a client sees before booking</p></div><div class="sp"><a href="@(Routes.To("experts.show", new { expert = Model.Expert.ExpertId }))" class="m-link">View as a client <i class="bi bi-box-arrow-up-right"></i></a></div></div>
  <div class="dcb p">
    <div class="ms-profile-hero">
      @await Html.PartialAsync("~/Views/Components/_Avatar.cshtml", new AvatarModel { User = Model.User, Box = "ava ava-xl", Fallback = "av av-xl" })
      <div>
        <div class="d-flex align-items-center gap-2">
          <h2 class="m-h3" style="font-size:22px">@(Model.User.FullName)</h2>
          @if (Model.Expert.IsVerified())
{
<text><i class="bi bi-patch-check-fill" style="font-size:17px;color:#E0A63C"></i></text>
}
        </div>
        <p class="m-body" style="margin-top:4px">@(Model.Expert.Title) &middot; @(Model.Expert.ExperienceYears) years</p>
        <div class="ph-meta">
          <span><i class="bi bi-geo-alt"></i> @(Model.User.City)</span>
          <span><i class="bi bi-star-fill" style="color:#E0A63C"></i> @(Helpers.Truthy(Model.Expert.Rating) ? Helpers.NumberFormat(Convert.ToDouble(Model.Expert.Rating), 1) + " (" + Model.Reviews + " " + Helpers.Plural("review", Model.Reviews) + ")" : "No reviews yet")</span>
          <span><i class="bi bi-briefcase"></i> @(Model.Completed) @(Helpers.Plural("booking", Model.Completed)) delivered</span>
        </div>
        <div class="taglist ms-ph-tags" style="margin-top:14px">
          @if (Model.Expert.IsVerified())
{
<text><span class="ms-ph-chip gold"><i class="bi bi-patch-check-fill"></i> Verified expert</span></text>
}
else
{
<text><span class="ms-ph-chip"><i class="bi bi-hourglass-split"></i> Waiting for verification</span></text>
}
          @if (Helpers.Truthy(Model.TopRated))
{
<text><span class="ms-ph-chip"><i class="bi bi-award"></i> Top 5% in @(Helpers.Before(Model.Expert.Specialization, " "))</span></text>
}
          @if (Helpers.Truthy(Model.ReplyHours))
{
<text><span class="ms-ph-chip"><i class="bi bi-lightning-charge"></i> Replies in @(Model.ReplyHours) @(Helpers.Plural("hour", Model.ReplyHours))</span></text>
}
        </div>
      </div>
    </div>
    <p class="m-body" style="margin-top:22px">@(Model.Expert.Bio)</p>
    <h4 class="m-h4" style="margin:24px 0 12px">Specialization</h4>
    <div class="taglist">
      <span class="fchip on">@(Model.Expert.Specialization)</span>
      @foreach (var field in Model.Expert.ServiceFields())
{
<text>
        @if (field != Model.Expert.Specialization)
{
<text><span class="fchip">@(field)</span></text>
}
      </text>
}
    </div>
    <h4 class="m-h4" style="margin:24px 0 6px">My price</h4>
    <div class="pl" style="border-bottom:0"><span>@(Model.Expert.IsConsultant() ? "My session price" : "Smallest service I accept")</span><span>@(Helpers.Sar(Model.Expert.SessionPrice, 0)) SAR</span></div>
    <p class="m-help">You send one price with every proposal. Masar takes @(Helpers.ToInt32((Config.Masar.Commission * 100)))% of the agreed price,
      and the client pays the VAT on top.</p>
    <h4 class="m-h4" style="margin:24px 0 12px">Portfolio</h4>
    <div class="pgrid" style="margin-top:0">
      @if (Model.Portfolio.Any())
{
    foreach (var item in Model.Portfolio)
    {
<text>
        <figure class="pitem"><img src="@(item.Image)" alt="@(item.Title)">
          <figcaption>@(item.Title)</figcaption></figure>
      </text>
    }
}
else
{
<text>
        <p class="m-small">No portfolio items yet. Three or more raise your profile strength.</p>
      </text>
}
    </div></div>
</div>
  <div class="dgrid" style="display:flex;flex-direction:column;gap:20px">
<div class="dcard">
  <div class="dch"><div><h3 class="m-h3">Profile strength</h3><p class="m-small">Complete profiles get 3 times more bookings</p></div></div>
  <div class="dcb p"><div class="rstat"><div>@Html.Raw(C.Ring(Model.Strength))</div><div class="ckl">
      @foreach (var (label, done) in Model.Items.Pairs())
{
<text>
        <div><i class="bi @(Helpers.Truthy(done) ? "bi-check-circle-fill" : "bi-circle todo")"></i> @(label)</div>
      </text>
}
    </div></div>
    <a href="@(Routes.To("expert.settings"))" class="m-btn m-btn-primary m-btn-block" style="margin-top:20px">
      <i class="bi bi-pencil"></i> Edit my profile</a></div>
</div>
<div class="dcard">
  <div class="dch"><div><h3 class="m-h3">Verification</h3><p class="m-small">Documents you gave Masar</p></div></div>
  <div class="dcb p"><div class="pdocs">
      @foreach (var row in Model.Documents)
{
<text>
        @{
    var doc = row.Doc;
}
        <div class="pdoc"><i class="bi bi-file-earmark-text f"></i>
          <div><b>@(row.Type)</b><span class="m-small">@(Helpers.Truthy(doc) ? (Helpers.Truthy(doc.FileExists()) ? System.IO.Path.GetFileName(doc.FilePath) : "File not available") + " · " + doc.SubmittedDate.Format("j M Y") : (Helpers.Truthy(row.Required) ? "Required, not uploaded yet" : "Optional, not uploaded"))</span></div>
          @if (Helpers.Truthy(doc) && (doc.Status == "Approved"))
{
<text>
            <span class="m-chip chip-ok"><i class="bi bi-check-lg"></i> Verified</span>
          </text>
}
else if (Helpers.Truthy(doc))
{
<text>
            @await Html.PartialAsync("~/Views/Components/_Status.cshtml", new StatusModel { Kind = "document", Value = doc.Status })
          </text>
}
else
{
<text>
            @await Html.PartialAsync("~/Views/Components/_Status.cshtml", new StatusModel { Kind = "document", Value = "Missing" })
          </text>
}</div>
      </text>
}
    </div>
    <div class="note" style="margin-top:18px"><i class="bi bi-shield-check"></i>
      @if (Model.Expert.IsVerified() && Helpers.Truthy(Model.ApprovedSince))
{
<text>
        Verified expert since @(Helpers.ParseDate(Model.ApprovedSince).Format("j F Y")). All three required documents are approved.
      </text>
}
else
{
<text>
        Your profile goes live as soon as the three required documents are approved.
        <a class="m-link" href="@(Routes.To("expert.documents"))" style="margin-left:auto">Upload</a>
      </text>
}
    </div></div>
</div>
  </div>
</div>
