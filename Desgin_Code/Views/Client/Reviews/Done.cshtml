@model Masar.ViewModels.Client.ReviewDoneViewModel
@{
    Layout = "~/Views/Shared/_App.cshtml";
    ViewData["navItem"] = "bookings";
    ViewData["pageClass"] = "center-page";
    ViewData["title"] = "Thank you for your review - Masar";
}
<div class="statebox">
  <div class="bigicon ok"><i class="bi bi-star-fill"></i></div>
  <h1 class="m-h1" style="margin-top:24px">Thank you for your review</h1>
  <p class="m-body" style="margin-top:12px;max-width:460px">It is now shown on @(Model.User?.FullName)'s profile and
    counted in @(Helpers.Truthy(Model.Expert?.Rating) ? "the" : "her") rating.</p>
  <div class="card pad" style="width:560px;margin-top:28px;text-align:left">
    <div class="rev-h">
      @await Html.PartialAsync("~/Views/Components/_Avatar.cshtml", new AvatarModel { User = Model.Review.User, Box = "ava", Fallback = "av" })
      <div><div class="m-h4">@(Model.Review.User.FullName)</div><p class="m-small">@(Model.Review.User.City)</p></div>
      <div class="rev-r">@await Html.PartialAsync("~/Views/Components/_Stars.cshtml", new StarsModel { Rating = Model.Review.Rating })<p class="m-small">@(Model.Review.ReviewDate.IsToday() ? "Today" : Model.Review.ReviewDate.Format("j M Y"))</p></div>
    </div>
    @if (Convert.ToString(Model.Review.Comment).Trim() != "")
{
<text><p class="m-body">@(Model.Review.Comment)</p></text>
}
    <span class="m-chip">@(Model.Chip)</span>
  </div>
  <div class="d-flex gap-3" style="margin-top:28px">
    <a href="@(Routes.To("bookings.index"))" class="m-btn m-btn-outline">Back to my bookings</a>
    <a href="@(Model.BookAgain)" class="m-btn m-btn-primary">Book with @(Model.User?.FirstName) again</a>
  </div>
</div>
