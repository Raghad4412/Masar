@model Masar.ViewModels.Client.BookingPayViewModel
@{
    Layout = "~/Views/Shared/_App.cshtml";
    ViewData["navItem"] = "bookings";
    ViewData["pageClass"] = Helpers.Truthy(Model.Declined) ? "center-page" : "";
    ViewData["title"] = "Payment - Masar";
}
@section Prepage {

@await Html.PartialAsync("~/Views/Partials/_Steps.cshtml", null, new ViewDataDictionary(ViewData) { ["step"] = 3 })

}

@if (Helpers.Truthy(Model.Declined))
{
<text>
  <div class="statebox">
    <div class="bigicon danger"><i class="bi bi-x-circle"></i></div>
    <h1 class="m-h1" style="margin-top:24px">Your bank declined the payment</h1>
    <p class="m-body" style="margin-top:12px;max-width:470px">The payment of <b>@(Helpers.NumberFormat(Model.Total, 2)) SAR</b> was
      not completed. Nothing was taken from your account.</p>
    <div class="reason">
      <div class="m-h4">What you can try</div>
      <span><i class="bi bi-dot"></i> Check that the card has enough balance and is open for online payment.</span>
      <span><i class="bi bi-dot"></i> Try Apple Pay or another card.</span>
      <span><i class="bi bi-dot"></i> Call your bank if the problem continues.</span>
    </div>
    <div class="d-flex gap-3" style="margin-top:28px">
      <a href="@(Routes.To("bookings.pay", new { session = Model.Session.ConsultationSessionId }))" class="m-btn m-btn-outline">Choose another method</a>
      <a href="@(Routes.To("bookings.pay", new { session = Model.Session.ConsultationSessionId, method = "Credit card" }))" class="m-btn m-btn-primary">Try again</a>
    </div>
    <p class="m-small" style="margin-top:20px"><i class="bi bi-clock-history"></i> Your slot on @(Model.Session.StartsAt().Format("l j M"))
      at @(Model.Session.SlotLabel) is held for <span data-ms-countdown="@(Model.HoldSeconds)">@(Helpers.ToInt32(Math.Ceiling(Convert.ToDouble(Model.HoldSeconds / 60))))</span> more minutes.</p>
  </div>
</text>
}
else
{
<text>
<form method="POST" action="@(Routes.To("bookings.pay.store", new { session = Model.Session.ConsultationSessionId }))" id="pay-form">
  @Html.AntiForgeryToken()
  <div class="wrap">
    <div class="bcols">
      <section>
        @if (Helpers.Truthy(Model.Card))
{
<text>
          <div class="card pad">
            <h2 class="m-h2" style="font-size:26px">Card details</h2>
            <input type="hidden" name="Payment_Method" value="Credit card">
            <div class="cardbox">
              <div class="cb-top"><span class="m-small" style="color:#CFE2D7">Credit card</span><i class="bi bi-credit-card-2-front"></i></div>
              <div class="cb-num">&bull;&bull;&bull;&bull; &nbsp; &bull;&bull;&bull;&bull; &nbsp; &bull;&bull;&bull;&bull; &nbsp; &bull;&bull;&bull;&bull;</div>
              <div class="cb-bot"><span>@(AuthUser.FullName.ToUpperInvariant())</span><span>MM / YY</span></div>
            </div>
            <div class="m-fg" style="margin-top:24px">
              <label class="m-label" for="card_number">Card number</label>
              <div class="m-input @Html.Raw((Errors.GetBag("default").Has("card_number") ? " err " : ""))">
                <input id="card_number" name="card_number" type="text" inputmode="numeric" required maxlength="19"
                       autocomplete="cc-number" data-ms-card placeholder="0000 0000 0000 0000">
                <i class="bi bi-credit-card-2-front" style="color:var(--teal)"></i>
              </div>
              @if (Errors.GetBag("default").Has("card_number"))
{
<text><p class="m-err"><i class="bi bi-exclamation-circle"></i> @(Errors.GetBag("default").First("card_number"))</p></text>
}
            </div>
            <div class="m-two">
              <div class="m-fg"><label class="m-label" for="card_expiry">Expiry date</label>
                <div class="m-input @Html.Raw((Errors.GetBag("default").Has("card_expiry") ? " err " : ""))">
                  <input id="card_expiry" name="card_expiry" type="text" inputmode="numeric" required maxlength="7"
                         autocomplete="cc-exp" data-ms-expiry placeholder="MM / YY">
                </div>
                @if (Errors.GetBag("default").Has("card_expiry"))
{
<text><p class="m-err"><i class="bi bi-exclamation-circle"></i> @(Errors.GetBag("default").First("card_expiry"))</p></text>
}
              </div>
              <div class="m-fg"><label class="m-label" for="card_cvc">Security code</label>
                <div class="m-input @Html.Raw((Errors.GetBag("default").Has("card_cvc") ? " err " : ""))">
                  <input id="card_cvc" name="card_cvc" type="password" inputmode="numeric" required pattern="\d{3,4}"
                         maxlength="4" autocomplete="cc-csc" placeholder="&bull;&bull;&bull;">
                </div>
                @if (Errors.GetBag("default").Has("card_cvc"))
{
<text><p class="m-err"><i class="bi bi-exclamation-circle"></i> @(Errors.GetBag("default").First("card_cvc"))</p></text>
}
              </div>
            </div>
            <div class="m-fg"><label class="m-label" for="card_name">Name on the card</label>
              <div class="m-input @Html.Raw((Errors.GetBag("default").Has("card_name") ? " err " : ""))">
                <input id="card_name" name="card_name" type="text" required maxlength="60" autocomplete="cc-name"
                       placeholder="@(AuthUser.FullName.ToUpperInvariant())">
              </div>
              @if (Errors.GetBag("default").Has("card_name"))
{
<text><p class="m-err"><i class="bi bi-exclamation-circle"></i> @(Errors.GetBag("default").First("card_name"))</p></text>
}
            </div>
            <div class="secure-row"><i class="bi bi-shield-lock-fill"></i>
              <p class="m-small">You will be asked to confirm the payment with the code your bank sends you (3-D Secure).</p></div>
          </div>
        </text>
}
else
{
<text>
          <div class="card pad">
            <h2 class="m-h2" style="font-size:26px">Choose how to pay</h2>
            <div class="pays">
              <label class="pay @(Old("Payment_Method", "mada") == "mada" ? "on" : "") @Html.Raw((Errors.GetBag("default").Has("Payment_Method") ? " err " : ""))">
                <input class="ms-input" type="radio" name="Payment_Method" value="mada" required @(Old("Payment_Method", "mada") == "mada" ? "checked" : "")>
                <span class="radio"><i class="bi bi-check-lg"></i></span>
                <span class="pname"><i class="bi bi-credit-card-2-front"></i> mada</span>
                <span class="m-small">Saudi debit card &middot; no extra fee</span></label>
              <label class="pay @(Old("Payment_Method") == "Apple Pay" ? "on" : "")">
                <input class="ms-input" type="radio" name="Payment_Method" value="Apple Pay" required @(Old("Payment_Method") == "Apple Pay" ? "checked" : "")>
                <span class="radio"><i class="bi bi-check-lg"></i></span>
                <span class="pname"><i class="bi bi-apple"></i> Apple Pay</span>
                <span class="m-small">Pay with Face ID or Touch ID</span></label>
              <label class="pay @(Old("Payment_Method") == "Credit card" ? "on" : "")">
                <input class="ms-input" type="radio" name="Payment_Method" value="Credit card" required @(Old("Payment_Method") == "Credit card" ? "checked" : "")
                       onchange="window.location='@(Routes.To("bookings.pay", new { session = Model.Session.ConsultationSessionId, method = "Credit card" }))'">
                <span class="radio"><i class="bi bi-check-lg"></i></span>
                <span class="pname"><i class="bi bi-credit-card"></i> Credit card</span>
                <span class="m-small">Visa or Mastercard</span></label>
            </div>
            @if (Errors.GetBag("default").Has("Payment_Method"))
{
<text><p class="m-err"><i class="bi bi-exclamation-circle"></i> @(Errors.GetBag("default").First("Payment_Method"))</p></text>
}
            <div class="secure-row"><i class="bi bi-shield-lock-fill"></i>
              <p class="m-small">Your card details are handled by the payment provider. Masar never stores the
                full number. The amount is released to the expert after the session is completed.</p></div>
          </div>
        </text>
}
      </section>
      <aside>
        @if (!(Helpers.Truthy(Model.Card)))
{
<text>
          @await Html.PartialAsync("~/Views/Partials/_MiniExpert.cshtml", null, new ViewDataDictionary(ViewData) { ["user"] = Model.User, ["expert"] = Model.Expert })
          <div style="height:18px"></div>
        </text>
}
        <div class="card pad">
          <h4 class="m-h4">Order summary</h4>
          @await Html.PartialAsync("~/Views/Partials/_PriceSummary.cshtml", null, new ViewDataDictionary(ViewData) { ["line"] = (Model.Type?.TypeName) + " · " + Config.Masar.SessionMinutes + " minutes", ["price"] = Model.Price, ["commission"] = Model.Commission, ["vat"] = Model.Vat, ["total"] = Model.Total })
          <button type="submit" class="m-btn m-btn-primary m-btn-block" style="margin-top:20px">Pay @(Helpers.NumberFormat(Model.Total, 2)) SAR</button><p class="m-small" style="text-align:center;margin-top:12px">@(Helpers.Truthy(Model.Card) ? "Protected by 3-D Secure" : Model.Session.StartsAt().Format("l j M") + " · " + Model.Session.SlotLabel)</p>
        </div>
      </aside>
    </div>
  </div>
</form>

<div class="ms-dialog" id="ms-processing" hidden>
  <div class="statebox">
    <div class="spin">@await Html.PartialAsync("~/Views/Svg/_Spinner.cshtml")</div>
    <h1 class="m-h1" style="margin-top:28px">Confirming your payment…</h1>
    <p class="m-body" style="margin-top:12px;max-width:440px">Your bank is checking the payment of
      <b>@(Helpers.NumberFormat(Model.Total, 2)) SAR</b>. Please do not close this window or press back.</p>
    <div class="proc">
      <span class="pstep done"><i class="bi bi-check-lg"></i> Card accepted</span>
      <span class="pstep live"><i class="bi bi-three-dots"></i> Confirming with your bank</span>
      <span class="pstep"><i class="bi bi-calendar-check"></i> Reserving your time slot</span>
    </div>
  </div>
</div>
<script>
  document.getElementById('pay-form').addEventListener('submit', function () {
    document.getElementById('ms-processing').hidden = false;
  });
</script>
</text>
}
